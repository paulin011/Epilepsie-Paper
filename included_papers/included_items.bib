@article{st-jeanDetectionFocalImpaired2025,
  title = {Detection of Focal Impaired Awareness Seizures Using a Biometric Shirt},
  author = {St-Jean, Jérôme and Gharbi, Oumayma and Toffa, Dènahin Hinnoutondji and Tran, Thi Phuoc Yen and Robert, Manon and Nguyen, Dang Khoa and Bou Assi, Elie},
