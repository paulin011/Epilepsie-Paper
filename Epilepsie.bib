  keywords = {digital health,epilepsy management,personalized intervention,real-time monitoring,review,seizure detection,wearable technology},
  file = {/home/paulin/Zotero/storage/4F4ZCRBV/Ahuja et al. - 2024 - Advancements in Wearable Digital Health Technology A Review of Epilepsy Management.pdf}
}

@article{aitzaouiatMachineLearningBased2022,
