@article{ahmedWearableSensorBased2017,
  title = {A Wearable Sensor Based Multi-Criteria-Decision-System for Real-Time Seizure Detection},
  author = {Ahmed, Abdullah and Ahmad, Waqas and Khan, Muhammad Jazib and Siddiqui, Shoaib Ahmed and Cheema, Hammad M.},
  date = {2017-07},
  journaltitle = {Annual International Conference of the IEEE Engineering in Medicine and Biology Society. IEEE Engineering in Medicine and Biology Society. Annual International Conference},
  shortjournal = {Annu Int Conf IEEE Eng Med Biol Soc},
  volume = {2017},
  eprint = {29060376},
  eprinttype = {pubmed},
  pages = {2377--2380},
  issn = {2694-0604},
  doi = {10.1109/EMBC.2017.8037334},
  abstract = {This paper presents a wireless, low power and low cost two part wearable for real-time epileptic seizure detection. Using parameters of Electro-cardiograph (ECG), Electro-dermal Activity (EDA), body motion and breathing rate (BR), a novel multi-criteria-decision-system (MCDS) is proposed that reduces false alarms and true negatives. The combination of a chest and hand worn wearable continuously senses these parameters transmitting the data to a smart phone application via BLE 4.0 where long-short-term-memory (LSTM) based anomaly detection algorithms and logistic classifiers decide on the occurrence of the seizure in real time. A 96\% precision and 90\% recall is achieved through testing on synthetic data.},
  langid = {english},
  keywords = {Algorithms,Humans,maybe,Monitoring Physiologic,Seizures,Smartphone,Wearable Electronic Devices},
  file = {/home/paulin/Zotero/storage/NB2XPCJ7/Ahmed et al. - 2017 - A wearable sensor based multi-criteria-decision-system for real-time seizure detection.pdf}
}

@article{ahujaAdvancementsWearableDigital2024,
