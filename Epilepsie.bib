@article{mikosWearablePatientAdaptiveFreezing2019,
  title = {A {{Wearable}}, {{Patient-Adaptive Freezing}} of {{Gait Detection System}} for {{Biofeedback Cueing}} in {{Parkinson}}'s {{Disease}}},
  author = {Mikos, Val and Heng, Chun-Huat and Tay, Arthur and Yen, Shih-Cheng and Chia, Nicole Shuang Yu and Koh, Karen Mui Ling and Tan, Dawn May Leng and Au, Wing Lok},
  date = {2019-06},
  journaltitle = {IEEE Transactions on Biomedical Circuits and Systems},
  volume = {13},
  number = {3},
  pages = {503--515},
  issn = {1940-9990},
  doi = {10.1109/TBCAS.2019.2914253},
  url = {https://ieeexplore.ieee.org/document/8703855/},
  urldate = {2025-11-21},
  abstract = {Freezing of Gait (FoG) is a common motor-related impairment among Parkinson's disease patients, which substantially reduces their quality of life and puts them at risk of falls. These patients benefit from wearable FoG detection systems that provide timely biofeedback cues and hence help them regain control over their gait. Unfortunately, the systems proposed thus far are bulky and obtrusive when worn. The objective of this paper is to demonstrate the first integration of an FoG detection system into a single sensor node. To achieve such an integration, features with low computational load are selected and dedicated hardware is designed that limits area and memory utilization. Classification is achieved with a neural network that is capable of learning in real time and thus allows the system to adapt to a patient during runtime. A small form factor FPGA implements the feature extraction and classification, whereas a custom PCB integrates the system into a single node. The system fits into a 4.5 × 3.5 × 1.5 cm3 housing case, weighs 32 g, and achieves 95.6\% sensitivity and 90.2\% specificity when adapted to a patient. Biofeedback cues are provided either through auditory or somatosensory means and the system can remain operational for longer than 9 h while providing cues. The proposed system is highly competitive in terms of classification performance and excels with respect to wearability and real-time patient adaptivity.},
  keywords = {Biological control systems,Biomedical monitoring,Feature extraction,FPGA,freezing of gait,Hardware,machine learning,parkinson's disease,patient adaptivity,Real-time systems,Sensitivity,Software algorithms,wearable devices},
  file = {/home/paulin/Zotero/storage/AK897VMI/Mikos et al. - 2019 - A Wearable, Patient-Adaptive Freezing of Gait Detection System for Biofeedback Cueing in Parkinson's.pdf}
}

