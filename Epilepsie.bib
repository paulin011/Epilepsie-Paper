  shorttitle = {{{VPSI}} 2.0},
  author = {Gopalakrishnan, Karthikeyan and Balakrishnan, Arunkumar and Govardhanan, Kousalya and S. Rajesh, Kandala N. V. P.},
  date = {2025-03},
  journaltitle = {IEEE Internet of Things Journal},
