@article{husseinFocalNonFocalEpilepsy2018,
  title = {Focal and {{Non-Focal Epilepsy Localization}}: {{A Review}}},
  shorttitle = {Focal and {{Non-Focal Epilepsy Localization}}},
  author = {Hussein, Ahmed Faeq and Arunkumar, N and Gomes, Chandima and Alzubaidi, Abbas K. and Habash, Qais Ahmed and Santamaria-Granados, Luz and Mendoza-Moreno, Juan Francisco and Ramirez-Gonzalez, Gustavo},
  date = {2018},
