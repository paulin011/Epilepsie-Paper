@article{chenDeterministicLearningBasedWEST2022,
  title = {Deterministic {{Learning-Based WEST Syndrome Analysis}} and {{Seizure Detection}} on {{ECG}}},
  author = {Chen, Shiyao and Zheng, Runze and Wang, Tianlei and Jiang, Tiejia and Gao, Feng and Wang, Danping and Cao, Jiuwen},
  date = {2022-11},
  journaltitle = {IEEE Transactions on Circuits and Systems II: Express Briefs},
  volume = {69},
  number = {11},
  pages = {4603--4607},
  issn = {1558-3791},
  doi = {10.1109/TCSII.2022.3188162},
  url = {https://ieeexplore.ieee.org/document/9828514/},
  urldate = {2025-11-21},
  abstract = {WEST syndrome is an unknown etiology infant epilepsy, which is characterized by the flexion spastic seizure, intellectual motion development lag, electrode abnormalities, arrhythmia. In this brief, we present a novel electrocardiogram (ECG) based WEST syndrome epilepsy seizure detection method. Based on deterministic learning (DT) theory, the dynamic model of ECG is firstly constructed. The cardiodynamicsgrams (CDGs) of ECGs in seizure and interictal periods are then derived. Nonlinear features on CDGs are extracted for WEST syndrome characterization. For performance evaluation, experiments on ECGs of 12 WEST syndrome patients from the Children’s Hospital of Zhejiang University School of Medicine (CHZU) is carried out. The proposed method can obtain an average of 94.49\% F1-score, 93.76\% precision and 95.58\% accuracy, that outperforms the heart rate variability (HRV) based methods.},
  keywords = {ECG,Electrocardiography,Epilepsy,Feature extraction,heart rate variability,Heart rate variability,Heuristic algorithms,infantile spasms,maybe,Myocardium,Pediatrics,seizure detection,WEST epilepsy syndrome},
  file = {/home/paulin/Zotero/storage/2CGJXFK4/Chen et al. - 2022 - Deterministic Learning-Based WEST Syndrome Analysis and Seizure Detection on ECG.pdf;/home/paulin/Zotero/storage/5SNPJT6X/Chen et al. - 2022 - Deterministic Learning-Based WEST Syndrome Analysis and Seizure Detection on ECG.pdf}
}

