@article{odeDevelopmentEpilepticSeizure2023,
  title = {Development of an~Epileptic Seizure Prediction Algorithm Using {{R}}–{{R}} Intervals with Self-Attentive Autoencoder},
  author = {Ode, Rikumo and Fujiwara, Koichi and Miyajima, Miho and Yamakawa, Toshikata and Kano, Manabu and Jin, Kazutaka and Nakasato, Nobukazu and Sawai, Yasuko and Hoshida, Toru and Iwasaki, Masaki and Murata, Yoshiko and Watanabe, Satsuki and Watanabe, Yutaka and Suzuki, Yoko and Inaji, Motoki and Kunii, Naoto and Oshino, Satoru and Khoo, Hui Ming and Kishima, Haruhiko and Maehara, Taketoshi},
