@article{mironAutonomicBiosignalsSeizure2025,
  title = {Autonomic Biosignals, Seizure Detection, and Forecasting},
  author = {Miron, Gadi and Halimeh, Mustafa and Jeppesen, Jesper and Loddenkemper, Tobias and Meisel, Christian},
